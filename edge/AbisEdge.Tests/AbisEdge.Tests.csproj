<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AbisEdge\AbisEdge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real plant tag map, copied so PlantConfigTests can PARSE it in CI. It is hand-edited on
         the OPC boxes and a malformed edit (a duplicate key, a stray comma) only surfaces as a service
         that won't start — on the plant floor, not here. Parsing it in CI catches that at review time. -->
    <None Include="..\appsettings.Plant.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
