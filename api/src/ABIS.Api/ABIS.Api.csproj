<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Abis.Api</RootNamespace>
    <AssemblyName>ABIS.Api</AssemblyName>
  </PropertyGroup>

  <!-- Let the test project reach internal seed builders (e.g. AbisSchema.BuildOwnedDdl) so the
       Oracle-only static-init crash is guarded by a plain unit test. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ABIS.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <!-- Pure-managed LDAP client for on-prem Active Directory sign-in (Auth:Ldap simple-bind).
         Chosen over System.DirectoryServices.Protocols so the self-contained Linux deploy needs
         no native libldap OS package. Only exercised when Auth:Ldap:Enabled=true. -->
    <PackageReference Include="Novell.Directory.Ldap.NETStandard" Version="3.6.0" />
    <!-- Lets the app integrate with systemd (Type=notify, journald-friendly logs)
         when installed as a native Linux service. No-op when not run under systemd,
         so the Docker/console paths are unaffected. See docs/INSTALL_PLAN.md. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <!-- Production driver. Selected at runtime via Database:Provider=Oracle.
         Not exercised by the test suite (no Oracle instance in CI). -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.5.1" />
    <!-- Read-only driver for the secondary WinSPC (SQL Server) quality database.
         Only used when WinSpc:Enabled=true; the test suite exercises the WinSPC
         repository against a SQLite mimic, not this driver (no SQL Server in CI). -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <!--
    Make a LOCAL build report the version it actually is.

    build-deb.sh already stamps packaged builds: it passes an InformationalVersion taken from
    `git describe` (with tags, always, dirty), which is what makes a deployed app say
    v0.9.0-2-g781456f at `/`. A plain `dotnet run` got none of that and fell back to the SDK's own
    default of 1.0.0 — a number ABIS has never released, sitting in the sidebar badge looking like a
    real answer.

    This closes that gap for anyone running from a checkout. It does NOT override a version passed on
    the command line: an InformationalVersion set that way is a GLOBAL property, and MSBuild silently
    ignores a target's attempt to reassign one — so CI and build-deb.sh keep winning exactly as before,
    and that is why there is no condition guarding against them here.

    There deliberately is no `Condition` on InformationalVersion being empty either. It never is: the
    SDK derives it from Version during evaluation, so by the time any target runs it already reads
    1.0.0 and such a condition would skip every single time. That was the first version of this and it
    silently did nothing.

    Everything about it degrades quietly. No git on PATH, a tarball with no .git directory, a shallow
    clone with no tags — the Exec fails, the condition below is false, and the build carries on with
    the SDK default. A version string is not worth failing a build over.

    (XML comments cannot contain a double hyphen, which is why the git flags are described in words.)
  -->
  <Target Name="StampGitVersion" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git describe --tags --always --dirty"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          ContinueOnError="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDescribe" />
      <Output TaskParameter="ExitCode" PropertyName="_GitDescribeExit" />
    </Exec>
    <PropertyGroup Condition="'$(_GitDescribeExit)' == '0' and '$(_GitDescribe)' != ''">
      <InformationalVersion>$(_GitDescribe.Trim())</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
