{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=abis_dev.db",
    "Seed": true
  },
  "ApiKeys": {
    "Enabled": true,
    "HeaderName": "X-Api-Key",
    "Keys": [ "dev-local-key" ]
  },
  "Auth": {
    "Jwt": {
      "SigningKey": "abis-dev-signing-key-change-me-at-least-32b",
      "Issuer": "abis",
      "Audience": "abis-ui",
      "RequireHttpsMetadata": false
    }
  }
}
