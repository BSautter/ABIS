# .NET build output
[Bb]in/
[Oo]bj/
[Oo]ut/
*.user

# Release tarballs (build-release.sh output)
dist/

# Locally published deploy artifacts (e.g. the self-contained edge drop for the OPC boxes).
# Hundreds of MB of build output — never committed; rebuild with `dotnet publish` instead.
artifacts/

# Local dev SQLite fixtures (the API seeds these at runtime)
*.db
*.db-shm
*.db-wal

# Generated API contract + clients (produced in CI as artifacts)
openapi.json
abis-client.ts
python-client/

# Deployment secrets (use .env.example as the template)
.env

# IDE / OS cruft
.vs/
.idea/
.vscode/
.DS_Store

# Python
__pycache__/
*.pyc
sql_statements.json
