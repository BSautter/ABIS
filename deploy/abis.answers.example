# Example answers file for an unattended ABIS install:
#   sudo ./install.sh --unattended --answers /path/to/abis.answers
#
# This file is SOURCED by install.sh, so it is shell syntax: quote any value
# containing spaces, '=', ';' or parentheses (the Oracle connection string does).
# Keep it readable only by root (chmod 600) — it holds the DB password + API key.

# Oracle connection string (required). EZConnect (Data Source=host:port/service)
# or a full TNS descriptor. If a password/sub-value contains ';' '=' or a space,
# wrap THAT value in SINGLE quotes (Password='p;w') — do not use double quotes
# inside this value. Make sure the target DB instance is actually running.
ABIS_DB_CONNECTION="Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=192.168.1.230)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=abc11)));User Id=APP_USER;Password=CHANGE_ME;"

# API key clients send as X-Api-Key. Leave unset to auto-generate a strong one
# (printed at the end of the install).
#ABIS_API_KEY="paste-a-long-random-value-here"

# Loopback port Kestrel binds (nginx proxies to it). Default 8080.
ABIS_PORT=8080

# Database provider: Oracle (production) or Sqlite (demo). Default Oracle.
ABIS_DB_PROVIDER=Oracle

# --- Public exposure (nginx + TLS) -------------------------------------------
# Leave ABIS_SERVER_NAME unset to keep the service on loopback only (no nginx).
# Set it to the public FQDN to front the app with nginx + TLS.
#ABIS_SERVER_NAME="abis.example.com"

# TLS mode when ABIS_SERVER_NAME is set: letsencrypt | provided | none.
# Default is letsencrypt.
#ABIS_TLS_MODE=letsencrypt

# Required for letsencrypt: admin email for registration + expiry notices.
#ABIS_LETSENCRYPT_EMAIL="ops@example.com"

# Required for 'provided' TLS: paths to an existing cert + key on the server
# (e.g. an internal CA or a DNS-01 wildcard). Ignored otherwise.
#ABIS_TLS_CERT="/etc/ssl/abis/fullchain.pem"
#ABIS_TLS_KEY="/etc/ssl/abis/privkey.pem"
